{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/question.schema.json",
  "title": "CUET-OS validated question",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "subject", "topic", "subtopic", "type", "stem", "options", "correct_index", "explanation", "recognition_cue", "difficulty", "trap_type", "source", "validation", "usage_history", "status"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "topic": {"type": "string", "minLength": 1},
    "subtopic": {"type": "string", "minLength": 1},
    "type": {"enum": ["mcq4", "mcq5", "assertion", "arithmetic"]},
    "stem": {"type": "string", "minLength": 1},
    "options": {"type": "array", "minItems": 4, "maxItems": 5, "uniqueItems": true, "items": {"type": "string"}},
    "correct_index": {"type": "integer", "minimum": 0, "maximum": 4},
    "explanation": {"type": "string", "minLength": 1},
    "recognition_cue": {"type": "string", "minLength": 1},
    "difficulty": {"type": "integer", "minimum": 1, "maximum": 5},
    "trap_type": {"enum": ["E1", "E2", "E3", "E4", "E5", "E6", "E7", "E8", "E9", "E10"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator", "date", "batch"],
      "properties": {"generator": {"type": "string", "minLength": 1}, "date": {"type": "string", "minLength": 1}, "batch": {"type": "string", "minLength": 1}}
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["l1", "l2_engine", "l3_by", "timestamps"],
      "properties": {"l1": {"type": "string"}, "l2_engine": {"type": "string"}, "l3_by": {"type": ["string", "null"]}, "timestamps": {"type": "array", "items": {"type": "string", "minLength": 1}}}
    },
    "usage_history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["times_served", "times_correct"],
      "properties": {"times_served": {"type": "integer", "minimum": 0}, "times_correct": {"type": "integer", "minimum": 0}}
    },
    "status": {"enum": ["active", "quarantined", "retired"]}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "active"}}}, "then": {"properties": {"validation": {"properties": {"l1": {"const": "pass"}, "l2_engine": {"type": "string", "minLength": 1}}}}}}
  ]
}
